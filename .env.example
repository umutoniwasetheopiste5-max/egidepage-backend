# Copy this file to .env and fill in real values. Never commit the real .env.

PORT=8080

# --- Protection #2: response encryption key ---
# 32-byte (64 hex char) key used to AES-encrypt every API response body.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RESPONSE_ENC_KEY=replace_with_64_hex_chars

# --- Protection #3: signed short-lived stream token secret ---
# Different key from the one above. Used to sign/verify stream redirect tokens.
TOKEN_SIGNING_SECRET=replace_with_a_long_random_string

# How long a resolved stream link stays valid, in seconds (protection #3)
STREAM_TOKEN_TTL_SECONDS=900

# --- Protection #6: app-integrity shared secret ---
# Baked into the Android app (ideally obfuscated / derived at runtime, not a
# plain string constant - see android-client-notes/ for how to do that).
# The app signs each request with this; backend verifies the signature.
APP_SHARED_SECRET=replace_with_another_long_random_string

# --- Protection #1: where the app gets ITS config from is Firebase Remote
# Config / a small /config endpoint, not hardcoded. This backend doesn't need
# a Firebase key itself - it IS the thing the app now points to. If you want
# an even-more-indirect layer, you can put this backend's own URL into your
# existing Firebase Remote Config project and have the app read that instead
# of hardcoding this backend's domain either.
